{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pose-gallery-zh",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  "previews": {},
  "workers_dev": true,
  // 自定义域名绑定（要求 gmlumen.xyz 区域已托管在当前 Cloudflare 账号）
  "routes": [
    { "pattern": "ai-pose-gallery-zh.gmlumen.xyz", "custom_domain": true }
  ],
  // 可选环境变量：通过 `cf workers secrets update PROXY_ALLOWED_ORIGINS --worker ai-pose-gallery-zh --text "https://..." --type secret_text`
  // 或在 Cloudflare 控制台 Variables and Secrets 中配置 PROXY_ALLOWED_ORIGINS（支持逗号分隔的精确域名或 https://*.openai.com 泛子域名）
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 所有请求先经过 Worker：让页面级 http→https 跳转能生效（静态资源再回落到 ASSETS）
    "run_worker_first": true
  }
}
